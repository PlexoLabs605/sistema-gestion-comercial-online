# Base de datos PostgreSQL. En Railway: referenciar la variable del servicio
# Postgres, ej. DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion"

# Secreto de Auth.js (generar con: openssl rand -base64 32)
AUTH_SECRET=""

# OAuth de Google (Google Cloud Console > Credenciales > ID de cliente OAuth).
# URI de redirección autorizada: https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Emails (separados por coma) con rol de administrador de plataforma. Pueden
# entrar sin invitación y dar de alta negocios desde /platform-admin.
PLATFORM_ADMIN_EMAILS="admin@tudominio.com"

# Opcional: conexiones por negocio (cada negocio tiene su propio pool Prisma).
# TENANT_DB_CONNECTION_LIMIT=5

# Solo para generar migraciones nuevas del schema de negocios (npm run db:tenant:new)
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_shadow"
