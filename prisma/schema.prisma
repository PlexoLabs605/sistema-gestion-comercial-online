// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER STORY US-001: Productos y Variantes
// ============================================

model Product {
  id          String            @id @default(cuid())
  name        String
  brand       String?
  description String?
  barcode     String?           @unique
  imageUrl    String?           @map("image_url")
  categoryId  String            @map("category_id")
  marginCash        Decimal     @default(90) @map("margin_cash")        @db.Decimal(6, 2)
  surchargeDebit    Decimal     @default(5)  @map("surcharge_debit")    @db.Decimal(6, 2)
  surchargeFinanced Decimal     @default(20) @map("surcharge_financed") @db.Decimal(6, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  category    Category          @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String   @map("product_id")
  size                String
  color               String
  sku                 String   @unique
  costPrice           Decimal  @map("cost_price") @db.Decimal(10, 2)
  priceCash           Decimal  @map("price_cash") @db.Decimal(10, 2)
  priceDebit          Decimal  @map("price_debit") @db.Decimal(10, 2)
  priceFinanced       Decimal  @map("price_financed") @db.Decimal(10, 2)
  stockQuantity       Int      @map("stock_quantity") @default(0)
  minStockAlert       Int      @map("min_stock_alert") @default(1)
  tiendanubeProductId String?  @map("tiendanube_product_id")
  tiendanubeVariantId String?  @map("tiendanube_variant_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]

  @@index([sku])
  @@index([productId])
  @@map("product_variants")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
}

// ============================================
// USER STORY US-016: Autenticación
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("users")
}

// ============================================
// USER STORY US-006: Compras
// ============================================

model Supplier {
  id          String     @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  
  purchases   Purchase[]
  
  @@map("suppliers")
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String         @map("supplier_id")
  purchaseDate  DateTime       @default(now()) @map("purchase_date")
  totalAmount   Decimal        @map("total_amount") @db.Decimal(10, 2)
  notes         String?
  status        String         @default("completed") // completed, pending, cancelled
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]
  
  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id               String         @id @default(cuid())
  purchaseId       String         @map("purchase_id")
  productVariantId String         @map("product_variant_id")
  quantity         Int
  unitCost         Decimal        @map("unit_cost") @db.Decimal(10, 2)
  subtotal         Decimal        @db.Decimal(10, 2)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  
  @@index([purchaseId])
  @@index([productVariantId])
  @@map("purchase_items")
}

// ============================================
// USER STORY US-009: Ventas
// ============================================

model Sale {
  id            String     @id @default(cuid())
  saleDate      DateTime   @map("sale_date")
  paymentMethod String     @map("payment_method") // cash, card, transfer
  priceType     String     @map("price_type") // cash, debit, financed
  totalAmount   Decimal    @map("total_amount") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")

  items         SaleItem[]
  invoice       Invoice?

  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id               String         @id @default(cuid())
  saleId           String         @map("sale_id")
  productVariantId String         @map("product_variant_id")
  quantity         Int
  unitPrice        Decimal        @map("unit_price") @db.Decimal(10, 2)
  subtotal         Decimal        @db.Decimal(10, 2)

  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([saleId])
  @@index([productVariantId])
  @@map("sale_items")
}

// ============================================
// USER STORY US-020: Integración Tienda Nube
// ============================================

model TiendanubeConfig {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  accessToken String    @map("access_token")
  isActive    Boolean   @default(true) @map("is_active")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tiendanube_config")
}

model SyncLog {
  id           String   @id @default(cuid())
  action       String   // 'import' | 'export' | 'webhook'
  status       String   // 'success' | 'error'
  details      String?  @db.Text
  errorMessage String?  @map("error_message") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sync_logs")
}

// ============================================
// USER STORY US-021: Facturación Electrónica AFIP
// ============================================

model AfipConfig {
  id             String   @id @default(cuid())
  cuit           String
  certContent    String   @map("cert_content") @db.Text
  keyContent     String   @map("key_content") @db.Text
  accessToken    String?  @map("access_token") @db.Text
  puntoVenta     Int      @map("punto_venta")
  productionMode Boolean  @default(false) @map("production_mode")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("afip_config")
}

model Invoice {
  id              String    @id @default(cuid())
  saleId          String    @unique @map("sale_id")
  sale            Sale      @relation(fields: [saleId], references: [id])
  invoiceType     String    @default("B") @map("invoice_type")
  invoiceNumber   String    @map("invoice_number")
  puntoVenta      Int       @map("punto_venta")
  cae             String?
  caeExpiration   DateTime? @map("cae_expiration")
  invoiceDate     DateTime  @default(now()) @map("invoice_date")
  totalAmount     Decimal   @db.Decimal(10, 2) @map("total_amount")
  customerName    String?   @map("customer_name")
  customerDni     String?   @map("customer_dni")
  pdfPath         String?   @map("pdf_path")
  pdfData         String?   @map("pdf_data") @db.Text
  status          String    @default("pending") // pending, issued, error
  errorMessage    String?   @db.Text @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("invoices")
}
